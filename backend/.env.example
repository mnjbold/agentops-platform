TELNYX_API_KEY=KEY...
TELNYX_ORGANIZATION_API_KEY=KEY...
TELNYX_PUBLIC_API_KEY=o8muu...
TELNYX_API_BASE=https://api.telnyx.com/v2

# ---- Softphone (auto-purchased) ----
# WebRTC credential for the in-browser softphone
TELNYX_WEBRTC_USERNAME=w3jsoftphone...
TELNYX_WEBRTC_PASSWORD=...
TELNYX_WEBRTC_CONNECTION_ID=...

# Clean outbound line (no AI interception)
TELNYX_SOFTPHONE_FROM=+15078731084
TELNYX_SOFTPHONE_CONNECTION_ID=...

# ---- Webhook signing (REQUIRED in production) ----
# Generate with: cd backend && .venv/bin/python -m webhooks.security
WEBHOOK_HMAC_SECRET=

# ---- Test/optional (Claude) ----
# MINIMAX_API_KEY=sk-...

# ---- Appwrite (optional — for hosted auth/DB/realtime) ----
# Get from your Appwrite project console: https://cloud.appwrite.io or self-hosted
# Alternatively, drop these in backend/settings.json (git-ignored). The Appwrite
# client at backend/appwrite/client.py loads from env first, then settings.json.
# APPWRITE_API_KEY=standard_...
# APPWRITE_PROJECT_ID=...
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
