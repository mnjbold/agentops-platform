# ---- env / secrets ----
.env
.env.*
!.env.example
*.log
secrets/
# Phase A: auto-generated tenant master key (created on first run if
# TENANT_SECRET_MASTER_KEY is unset). Operator should set the env var
# instead for portable deployments.
.tenant_master_key

# Appwrite credentials (real secret-bearing JSON, see settings.example.json)
**/settings.json
**/settings.local.json

# SIP credentials (real secret-bearing JSON, see scripts/sip_credentials.example.json)
**/sip_credentials.json
**/sip_credentials*.local.json

# ---- python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- sqlite (runtime data) ----
*.db
*.db-shm
*.db-wal

# ---- node / frontend ----
node_modules/
.npm/
.yarn/

# ---- editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- staging dirs (move-out leftovers) ----
**/w3j-bijou-delete-me/
**/appwrite-delete-me/
**/.trash/

# ---- temp worktrees ----
.worktrees/

# ---- local runtime secrets / dev logs (NEVER commit) ----
# The `secrets/` rule above does not match these leading-dot directories.
# .runtime-secrets/ holds live Telnyx + Fernet + webhook-HMAC values.
.runtime-secrets/
.dev-logs/

# ---- scratch scripts & probes ----
# Explicit patterns, NOT `_*.py` — that would also swallow __init__.py.
_dbg*.py
_check_*.py
_mountcheck*.py
_routes_*.py
_health_check.py
*.tmp
*.bak
backend/_audit_tmp/

# ---- captured test / build output ----
*_test*.txt
*_tests.txt
phase_d_*.txt
_e_b_*.txt
_skills_test.txt
_sup_test*.txt
fail_check.txt
dbg.txt
debug_out.txt
routes.txt

# ---- PR / review scratch ----
.COMMENT_*.md
.PR_BODY.md

# Locally generated dev admin password (see scripts/dev.ps1)
.dev-password
